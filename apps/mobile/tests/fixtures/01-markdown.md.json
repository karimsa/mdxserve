								"value": "import http.server\nimport socketserver\n\nPORT = 4040\n\nwith socketserver.TCPServer((\"\", PORT), http.server.SimpleHTTPRequestHandler) as httpd:\n    print(f\"Serving at http://localhost:{PORT}\")\n    httpd.serve_forever()"
							},
