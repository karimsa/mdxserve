								"highlightLines": [],
								"value": "interface ServeOptions {\n  dir: string;\n  port: number;\n}\n\nfunction resolvePort(preferred: number): number {\n  // Falls back to a free port if `preferred` is already taken.\n  return isPortFree(preferred) ? preferred : findFreePort();\n}"
							},
							{
								"type": "paragraph",
								"children": [
									{
										"type": "text",
										"value": "TypeScript again, longer, with a title, line numbers, and a couple of highlighted\nlines (fence meta: "
									},
									{
										"type": "inlineCode",
										"value": "ts title=\"server.ts\" showLineNumbers {3-4}"
