FROM node:22-bookworm-slim AS source

WORKDIR /opt/mdxserve
COPY .build-source/ ./
RUN test -f .complete

FROM source AS build

RUN corepack enable
RUN yarn install --immutable
RUN yarn build

FROM source AS runtime-dependencies

RUN corepack enable
RUN YARN_ENABLE_IMMUTABLE_INSTALLS=true yarn workspaces focus --production

FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=8080 \
    MDXSERVE_IMMUTABLE_SITE=1 \
    MDXSERVE_HOME=/tmp/mdxserve/state \
    MDXSERVE_CACHE_HOME=/tmp/mdxserve/cache \
    __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=.vercel.app,mdxserve.karim.build

WORKDIR /opt/mdxserve
COPY --from=source /opt/mdxserve/package.json ./
COPY --from=build /opt/mdxserve/dist/ ./dist/
COPY --from=build /opt/mdxserve/client/ ./client/
COPY --from=runtime-dependencies /opt/mdxserve/node_modules/ ./node_modules/

COPY *.mdx /srv/docs/
COPY examples/ /srv/docs/examples/

RUN mkdir -p "$MDXSERVE_HOME" "$MDXSERVE_CACHE_HOME" \
    && chown -R node:node /tmp/mdxserve

USER node
WORKDIR /srv/docs
EXPOSE 8080

CMD ["sh", "-c", "exec node /opt/mdxserve/dist/cli.js --no-update-notifier serve -w /srv/docs --permissions restricted --host 0.0.0.0 --port \"${PORT}\""]
