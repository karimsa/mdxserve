{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react", "import"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"ignorePatterns": ["dist", "node_modules", ".yarn", "example", "skills"],
	"rules": {
		"react/react-in-jsx-scope": "off"
	}
}
