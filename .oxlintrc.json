{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react", "import"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"ignorePatterns": ["dist", "node_modules", ".yarn", "example", "skills"],
	"rules": {
		"react/react-in-jsx-scope": "off",
		// Stylesheets are imported for their side effect; Vite bundles them.
		"import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
		// The `__mdxserve*` window slots keep one instance per tab across HMR
		// re-executions; `_def` is tRPC's own router field.
		"eslint/no-underscore-dangle": [
			"warn",
			{
				"allow": [
					"__mdxserveQueryClient",
					"__mdxserveTrpcClient",
					"__mdxserveRealtimeBound",
					"__mdxserveRealtime",
					"__mdxserveRoot",
					"_def"
				]
			}
		],
		// AGENTS.md: never use single-letter variable names, even for small
		// things like `.map(e => e)` or try/catch statements.
		//
		// "_" stays allowed as the conventional name for a binding that is
		// deliberately ignored. Property names are not checked: `{ opacity: 0,
		// y: 4 }` is a framer-motion API key, not a variable a reader has to
		// keep track of — the rule is about names we choose, not names a
		// library hands us. `x`/`y` are excepted for the same reason one step
		// further: they are the DOM's own names for a coordinate pair, and
		// `properties: "never"` does not reach the members of a TS type
		// (see the `Point` interface in apps/web/src/ui/ExpandModal.tsx).
		"eslint/id-length": [
			"error",
			{ "min": 2, "exceptions": ["_", "x", "y"], "properties": "never" }
		]
	},
	// The workspace dependency direction (AGENTS.md): the web client and the app only import
	// types from the server, and neither imports the other; shared imports none of them and no
	// React value; the server never imports a client. Tests are outside these globs: a web
	// client test may run server code.
	"overrides": [
		{
			"files": ["apps/web/src/**", "apps/web/scripts/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@karimsa/mdxserve", "@karimsa/mdxserve/**", "**/packages/server/**"],
								"allowTypeImports": true,
								"message": "The web client may only `import type` from the server package."
							},
							{
								"group": ["@mdxserve/mobile", "@mdxserve/mobile/**", "**/apps/mobile/**"],
								"message": "The web client never imports the app."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/shared/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@karimsa/mdxserve",
									"@karimsa/mdxserve/**",
									"@mdxserve/web",
									"@mdxserve/web/**",
									"@mdxserve/mobile",
									"@mdxserve/mobile/**",
									"**/packages/server/**",
									"**/apps/web/**",
									"**/apps/mobile/**"
								],
								"message": "Shared code imports neither the server nor a client."
							},
							{
								"group": ["react", "react/**", "react-dom", "react-dom/**"],
								"allowTypeImports": true,
								"message": "Shared code may only `import type` from React."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/server/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@mdxserve/web",
									"@mdxserve/web/**",
									"@mdxserve/mobile",
									"@mdxserve/mobile/**",
									"**/apps/web/**",
									"**/apps/mobile/**"
								],
								"message": "The server never imports a client."
							}
						]
					}
				]
			}
		},
		{
			"files": ["apps/mobile/app/**", "apps/mobile/src/**"],
			"rules": {
				// expo-status-bar's `style` is a string ("auto", "light", "dark"), not a style object.
				"react/style-prop-object": ["warn", { "allow": ["StatusBar"] }],
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@karimsa/mdxserve", "@karimsa/mdxserve/**", "**/packages/server/**"],
								"allowTypeImports": true,
								"message": "The app may only `import type` from the server package."
							},
							{
								"group": ["@mdxserve/web", "@mdxserve/web/**", "**/apps/web/**"],
								"message": "The app never imports the web client."
							},
							{
								"group": ["react-dom", "react-dom/**"],
								"message": "The app renders with React Native, never react-dom."
							}
						]
					}
				]
			}
		}
	]
}
