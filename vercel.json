{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "corepack yarn install --immutable",
	"buildCommand": "corepack yarn workspace @mdxserve/site build",
	"outputDirectory": "apps/site/dist",
	"redirects": [
		{
			"source": "/srv/docs/README.mdx",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/srv/docs/get-started.mdx",
			"destination": "/get-started",
			"permanent": true
		},
		{
			"source": "/srv/docs/tour.mdx",
			"destination": "/tour",
			"permanent": true
		},
		{
			"source": "/srv/docs/:path*",
			"destination": "/",
			"permanent": false
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}
