{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"site": {
			"root": ".",
			"entrypoint": "site/Dockerfile.vercel",
			"ignoreCommand": "node site/deployment/prepare-context.mjs; exit 1"
		}
	},
	"redirects": [
		{
			"source": "/",
			"destination": "/srv/docs/README.mdx",
			"permanent": false
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": {
				"service": "site"
			}
		}
	]
}
