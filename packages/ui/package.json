		"react-native-web": "0.21.4",
		"uniwind": "1.14.0"
	},
	"peerDependencies": {
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-svg": "15.16.0"
	},
	"devDependencies": {
		"@types/react": "19.3.3",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-svg": "15.16.0",
		"typescript": "7.0.2"
	}
}
