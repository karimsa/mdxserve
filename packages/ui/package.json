{
	"name": "@mdxserve/ui",
	"private": true,
	"type": "module",
	"exports": {
		"./builtins/DataTable": {
			"types": "./src/builtins/DataTable.tsx",
			"react-native": "./src/builtins/DataTable.tsx",
			"default": "./src/builtins/DataTable.web.tsx"
		},
		"./builtins/Tooltip": {
			"types": "./src/builtins/Tooltip.tsx",
			"react-native": "./src/builtins/Tooltip.tsx",
			"default": "./src/builtins/Tooltip.web.tsx"
		},
		"./builtins/*": "./src/builtins/*.tsx",
		"./brand/*": "./src/brand/*.tsx",
		"./charts/chart-data": "./src/charts/chart-data.ts",
		"./primitives/Icon": {
			"types": "./src/primitives/Icon.tsx",
			"react-native": "./src/primitives/Icon.tsx",
			"default": "./src/primitives/Icon.web.tsx"
		},
		"./primitives/*": "./src/primitives/*.tsx",
		"./block-state/*": "./src/block-state/*.ts",
		"./data-table/*": "./src/data-table/*.ts",
		"./document/elements": {
			"types": "./src/document/elements.tsx",
			"react-native": "./src/document/elements.tsx",
			"default": "./src/document/elements.web.tsx"
		},
		"./document/environment": "./src/document/environment.tsx",
		"./document/nodes": "./src/document/nodes.tsx",
		"./document/*": "./src/document/*.ts",
		"./tokens/springs": "./src/tokens/springs.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@floating-ui/dom": "1.8.0",
		"@mdxserve/client": "workspace:*",
		"@mdxserve/shared": "workspace:*",
		"@tippyjs/react": "4.2.6",
		"bytes": "3.1.2",
		"diff": "9.0.0",
		"framer-motion": "13.0.0",
		"lucide-react": "1.30.0",
		"lucide-react-native": "1.30.0",
		"ms": "2.1.3",
		"react-native-web": "0.21.4",
		"uniwind": "1.14.0",
		"zod": "4.4.3"
	},
	"peerDependencies": {
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-svg": "15.16.0"
	},
	"devDependencies": {
		"@types/bytes": "3.1.6",
		"@types/ms": "2.1.0",
		"@types/react": "19.3.3",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-svg": "15.16.0",
		"typescript": "7.0.2"
	}
}
