{
	"name": "mdxserve-repo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "yarn workspace @karimsa/mdxserve build && yarn workspace @mdxserve/web build",
		"registry": "yarn workspace @mdxserve/web registry",
		"dev": "tsx scripts/dev.ts",
		"typecheck": "tsc --noEmit && yarn workspaces foreach --all --exclude mdxserve-repo --parallel run typecheck",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint --deny-warnings",
		"test": "vitest run && yarn workspaces foreach --all --exclude mdxserve-repo run test",
		"smoke": "yarn workspace @karimsa/mdxserve smoke",
		"changelog": "tsx scripts/changelog.ts",
		"deadcode": "knip --no-config-hints && knip --production --no-config-hints"
	},
	"packageManager": "yarn@4.18.0",
	"engines": {
		"node": ">=22.14"
	},
	"devDependencies": {
		"@types/node": "26.2.0",
		"@yarnpkg/types": "4.0.1",
		"git-cliff": "2.14.2",
		"knip": "6.48.0",
		"oxlint": "1.77.0",
		"prettier": "3.9.6",
		"tsx": "4.23.12",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10",
		"zx": "8.8.5"
	},
	"dependenciesMeta": {
		"better-sqlite3": {
			"built": false
		},
		"esbuild": {
			"built": false
		}
	}
}
