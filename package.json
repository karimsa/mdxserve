{
	"name": "mdxserve",
	"version": "0.1.0",
	"type": "module",
	"bin": "dist/cli.js",
	"files": [
		"dist",
		"client",
		"skills"
	],
	"scripts": {
		"build": "tsx scripts/build-registry.ts && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js --banner:js='#!/usr/bin/env node'",
		"registry": "tsx scripts/build-registry.ts",
		"dev": "tsx src/index.ts example",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint"
	},
	"packageManager": "yarn@4.18.0",
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/manrope": "5.3.0",
		"@mdx-js/react": "3.1.1",
		"@mdx-js/rollup": "3.1.1",
		"@tailwindcss/vite": "4.3.3",
		"@tippyjs/react": "4.2.6",
		"@vitejs/plugin-react": "6.0.5",
		"commander": "15.0.0",
		"date-fns": "4.4.0",
		"diff": "9.0.0",
		"framer-motion": "13.0.0",
		"hast-util-to-html": "9.0.5",
		"jotai": "2.20.2",
		"lucide-react": "1.30.0",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-mdx": "3.0.0",
		"mdast-util-to-hast": "13.2.1",
		"mdast-util-to-string": "4.0.0",
		"mermaid": "10.9.8",
		"micromark-extension-mdxjs": "3.0.0",
		"minisearch": "7.2.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"rehype-pretty-code": "0.14.5",
		"rehype-slug": "6.0.0",
		"remark-gfm": "4.0.1",
		"shiki": "4.4.2",
		"svg-pan-zoom": "3.6.2",
		"tailwindcss": "4.3.3",
		"tippy.js": "6.3.7",
		"trash": "10.1.1",
		"vite": "8.2.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/mdast": "4.0.4",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@types/svg-pan-zoom": "3.4.0",
		"@yarnpkg/types": "4.0.1",
		"esbuild": "0.28.2",
		"oxlint": "1.77.0",
		"prettier": "3.9.6",
		"tsx": "4.23.12",
		"typescript": "7.0.2"
	}
}
