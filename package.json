{
	"name": "@karimsa/mdxserve",
	"version": "0.0.1",
	"description": "Serve a directory of Markdown/MDX files, like `serve` but for docs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/karimsa/mdxserve.git"
	},
	"homepage": "https://github.com/karimsa/mdxserve#readme",
	"bugs": "https://github.com/karimsa/mdxserve/issues",
	"keywords": [
		"markdown",
		"mdx",
		"docs",
		"cli"
	],
	"type": "module",
	"bin": "dist/cli.js",
	"files": [
		"dist",
		"client",
		"!client/design-ref",
		"skills"
	],
	"scripts": {
		"build": "tsx scripts/build-registry.ts && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' && esbuild src/rendering/render-worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/render-worker.js",
		"registry": "tsx scripts/build-registry.ts",
		"dev": "tsx scripts/build-registry.ts && tsx src/index.ts serve -w example",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint",
		"test": "vitest run",
		"prepack": "yarn build",
		"smoke": "bash scripts/smoke-pack.sh"
	},
	"packageManager": "yarn@4.18.0",
	"engines": {
		"node": ">=22.12"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/manrope": "5.3.0",
		"@mdx-js/mdx": "3.1.1",
		"@mdx-js/react": "3.1.1",
		"@mdx-js/rollup": "3.1.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-query": "5.101.4",
		"@tippyjs/react": "4.2.6",
		"@tiptap/core": "3.29.2",
		"@tiptap/extension-image": "3.29.2",
		"@tiptap/extension-list": "3.29.2",
		"@tiptap/extension-table": "3.29.2",
		"@tiptap/markdown": "3.29.2",
		"@tiptap/pm": "3.29.2",
		"@tiptap/react": "3.29.2",
		"@tiptap/starter-kit": "3.29.2",
		"@trpc/client": "11.18.0",
		"@trpc/server": "11.18.0",
		"@trpc/tanstack-react-query": "11.18.0",
		"@vitejs/plugin-react": "6.0.5",
		"commander": "15.0.0",
		"date-fns": "4.4.0",
		"diff": "9.0.0",
		"framer-motion": "13.0.0",
		"hast-util-to-html": "9.0.5",
		"jotai": "2.20.2",
		"lockfile": "1.0.4",
		"lucide-react": "1.30.0",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-mdx": "3.0.0",
		"mdast-util-to-hast": "13.2.1",
		"mdast-util-to-string": "4.0.0",
		"mermaid": "10.9.8",
		"micromark-extension-mdxjs": "3.0.0",
		"minisearch": "7.2.0",
		"node-sqlite3-wasm": "0.8.60",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hot-toast": "2.6.0",
		"rehype-pretty-code": "0.14.5",
		"rehype-slug": "6.0.0",
		"remark-gfm": "4.0.1",
		"shiki": "4.4.2",
		"svg-pan-zoom": "3.6.2",
		"tailwindcss": "4.3.3",
		"tippy.js": "6.3.7",
		"trash": "10.1.1",
		"vfile-message": "4.0.3",
		"vite": "8.2.1",
		"zod": "4.4.3",
		"zx": "8.8.5"
	},
	"devDependencies": {
		"@types/lockfile": "1.0.4",
		"@types/mdast": "4.0.4",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@types/svg-pan-zoom": "3.4.0",
		"@yarnpkg/types": "4.0.1",
		"esbuild": "0.28.2",
		"fast-check": "4.9.0",
		"oxlint": "1.77.0",
		"prettier": "3.9.6",
		"tsx": "4.23.12",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
