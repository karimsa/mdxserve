{
  "name": "mdxserve",
  "version": "0.1.0",
  "type": "module",
  "bin": "dist/cli.js",
  "files": [
    "dist",
    "client"
  ],
  "scripts": {
    "build": "tsx scripts/build-registry.ts && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js --banner:js='#!/usr/bin/env node'",
    "registry": "tsx scripts/build-registry.ts",
    "dev": "tsx src/index.ts example",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "commander": "15.0.0",
    "mermaid": "^10.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "0.28.2",
    "tsx": "^4.23.12",
    "typescript": "7.0.2"
  }
}
